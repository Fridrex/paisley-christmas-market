# Application files at the repository root.
/*
!/.gitignore
!/.env.example
!/README.md
!/package.json
!/package-lock.json
!/eslint.config.mjs
!/playwright.config.ts
!/proxy.ts
!/tsconfig.json
!/vercel.json
!/app/
!/components/
!/lib/
!/public/
!/tests/
!/.github/
/.github/*
!/.github/workflows/
!/supabase/
/supabase/*
!/supabase/config.toml
!/supabase/migrations/
!/supabase/seed.sql

# Local credentials, tools and generated output.
.env*
!/.env.example
env.local*
*.pem
*.key
*.p12
*.pfx
*.log
*.dump
*.bak
*.swp
.DS_Store
Thumbs.db
AGENTS.md
.agents/
.codex/
.cursor/
.idea/
.vscode/
node_modules/
.next/
.vercel/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
coverage/

# Coursework documents and spreadsheets.
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xXmM]
*.[xX][lL][sS][xXmM]
