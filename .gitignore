# Keep the repository rooted at this folder and include the application files.
/*
!/.gitignore
!/.env.example
!/README.md
!/package.json
!/package-lock.json
!/eslint.config.mjs
!/playwright.config.ts
!/proxy.ts
!/tsconfig.json
!/vercel.json
!/app/
!/components/
!/lib/
!/public/
!/tests/
!/.github/
/.github/*
!/.github/workflows/
!/supabase/
/supabase/*
!/supabase/config.toml
!/supabase/migrations/
!/supabase/seed.sql

# Local credentials, generated files and coursework anywhere in the tree.
.env*
!/.env.example
env.local*
*.pem
*.key
node_modules/
.next/
.vercel/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xXmM]
*.[xX][lL][sS][xXmM]
*.[pP][pP][tT][xXmM]

# Generated by Next.js during local development.
AGENTS.md
